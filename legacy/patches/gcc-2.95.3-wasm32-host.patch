--- a/gcc/calls.c
+++ b/gcc/calls.c
@@ -440,15 +440,21 @@
 #if defined (HAVE_call) && defined (HAVE_call_value)
   if (HAVE_call && HAVE_call_value)
     {
+      /* Through pointers, since a target's call patterns need not take as
+	 many operands as are passed here, and a host that checks a direct
+	 call's arguments against its callee, WebAssembly, would trap.  */
+      rtx (*volatile call_value) () = gen_call_value;
+      rtx (*volatile call) () = gen_call;
+
