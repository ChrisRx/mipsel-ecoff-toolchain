--- a/libiberty/pexecute.c
+++ b/libiberty/pexecute.c
@@ -600,9 +600,58 @@
 
 #endif /* MPW */
 
+#ifdef __wasi__
+
+#include <stdlib.h>
+
+/* WASI has no processes. Each program the driver would run is written to
+   the file GCC_WASI_PLAN names instead, an argument to a line and a blank
+   line after the last, for the host to run in turn, and reported to have
+   succeeded: the host stops at the first that does not.  */
+
+int
+pexecute (program, argv, this_pname, temp_base, errmsg_fmt, errmsg_arg, flags)
+     const char *program;
+     char * const *argv;
+     const char *this_pname;
+     const char *temp_base;
+     char **errmsg_fmt, **errmsg_arg;
+     int flags;
+{
+  static int last_pid;
+  const char *plan = getenv ("GCC_WASI_PLAN");
+  FILE *f;
+  int i;
+
+  if (plan == 0 || (f = fopen (plan, "a")) == 0)
+    {
+      *errmsg_fmt = "cannot record %s: GCC_WASI_PLAN names no file to write";
+      *errmsg_arg = (char *) program;
+      return -1;
+    }
+  fprintf (f, "%s\n", program);
+  for (i = 1; argv[i] != 0; i++)
+    fprintf (f, "%s\n", argv[i]);
+  fprintf (f, "\n");
+  fclose (f);
+  return ++last_pid;
+}
+
+int
+pwait (pid, status, flags)
+     int pid;
+     int *status;
+     int flags;
+{
+  *status = 0;
+  return pid;
+}
+
+#endif /* __wasi__ */
+
 /* include for Unix-like environments but not for Dos-like environments */
 #if ! defined (__MSDOS__) && ! defined (OS2) && ! defined (MPW) \
-    && ! (defined (_WIN32) && ! defined (_UWIN))
+    && ! (defined (_WIN32) && ! defined (_UWIN)) && ! defined (__wasi__)
 
 extern int execv ();
 extern int execvp ();
--- /dev/null
+++ b/gcc/config/xm-wasm32.h
@@ -0,0 +1,30 @@
+/* Configuration for GNU C-compiler on WebAssembly with WASI, 32-bit and
+   little-endian like the i386, with which a wide integer of 32 bits keeps
+   what it generates the same.  */
+
+#define FALSE 0
+#define TRUE 1
+
+#define HOST_BITS_PER_CHAR 8
+#define HOST_BITS_PER_SHORT 16
+#define HOST_BITS_PER_INT 32
+#define HOST_BITS_PER_LONG 32
+#define HOST_BITS_PER_LONGLONG 64
+
+#define HOST_BITS_PER_WIDE_INT 32
+#define HOST_WIDE_INT int
+
+#include "tm.h"
+
+#define SUCCESS_EXIT_CODE 0
+#define FATAL_EXIT_CODE 33
+
+#ifndef alloca
+#ifdef __GNUC__
+#define alloca __builtin_alloca
+#else
+#include <alloca.h>
+#endif
+#endif
+
+#define POSIX
