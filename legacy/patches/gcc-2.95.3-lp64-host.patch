--- /dev/null
+++ b/gcc/config/xm-lp64.h
@@ -0,0 +1,30 @@
+/* Configuration for GNU C-compiler on a 64-bit host with 32-bit int.  */
+
+#define FALSE 0
+#define TRUE 1
+
+#define HOST_BITS_PER_CHAR 8
+#define HOST_BITS_PER_SHORT 16
+#define HOST_BITS_PER_INT 32
+#define HOST_BITS_PER_LONG 64
+#define HOST_BITS_PER_LONGLONG 64
+
+/* The target is 32-bit, and keeping the compiler's wide integer at that width
+   means this host generates exactly what a 32-bit host does.  */
+#define HOST_BITS_PER_WIDE_INT 32
+#define HOST_WIDE_INT int
+
+#include "tm.h"
+
+#define SUCCESS_EXIT_CODE 0
+#define FATAL_EXIT_CODE 33
+
+#ifndef alloca
+#ifdef __GNUC__
+#define alloca __builtin_alloca
+#else
+#include <alloca.h>
+#endif
+#endif
+
+#define POSIX
