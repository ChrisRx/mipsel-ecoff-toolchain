-  bcopy ((char *) &u, (char *) &CONST_DOUBLE_LOW (r), sizeof u);
+  CONST_DOUBLE_FROM_EXTRACT (r, u);
   pop_obstacks ();
 
   /* Don't touch const_double_chain in nested function; see force_const_mem.
@@ -3249,8 +3249,7 @@
       if (GET_MODE (x) != VOIDmode)
 	{
 	  value->mode = GET_MODE (x);
-	  bcopy ((char *) &CONST_DOUBLE_LOW (x),
-		 (char *) &value->un.du, sizeof value->un.du);
+	  CONST_DOUBLE_TO_EXTRACT (x, value->un.du);
 	}
       else
 	{
@@ -3673,7 +3672,7 @@
 	  if (GET_CODE (x) != CONST_DOUBLE)
 	    abort ();
 
-	  bcopy ((char *) &CONST_DOUBLE_LOW (x), (char *) &u, sizeof u);
+	  CONST_DOUBLE_TO_EXTRACT (x, u);
 	  assemble_real (u.d, pool->mode);
 	  break;
 
