Add a 64-bit Linux host. This compiler assumes it can read a double across adjacent
RTL fields, which only holds where those fields are the size of its wide integer.
Keeping the wide integer at the 32 bits of the target, and copying field by field,
makes the output match a 32-bit host exactly.

--- a/gcc/configure
+++ b/gcc/configure
@@ -3631,6 +3631,10 @@
  			thread_file='single'
  		fi
 		;;
+	x86_64-*-linux-gnu* | aarch64-*-linux-gnu*)
+		xm_file="xm-lp64.h xm-linux.h"
+		xmake_file=x-linux
+		;;
 	i[34567]86-*-linux-gnu*)	# Intel 80386's running GNU/Linux
 					# aka GNU/Linux C library 6
 		xmake_file=x-linux
--- a/gcc/real.h
+++ b/gcc/real.h
@@ -467,9 +467,21 @@
 
 #define REAL_VALUE_FROM_CONST_DOUBLE(to, from)		\
 do { union real_extract u;				\
-     bcopy ((char *) &CONST_DOUBLE_LOW ((from)), (char *) &u, sizeof u); \
+     CONST_DOUBLE_TO_EXTRACT ((from), u);		\
      to = u.d; } while (0)
 
+/* Copy between a CONST_DOUBLE and a union real_extract one wide int at a time,
+   since on a 64-bit host with a 32-bit wide int the fields of an rtx are wider
+   than what each holds, and so are not contiguous.  */
+#define CONST_DOUBLE_TO_EXTRACT(r, u)					\
+do { int i_;								\
+     for (i_ = 0; i_ < sizeof ((u).i) / sizeof ((u).i[0]); i_++)	\
+       (u).i[i_] = XWINT ((r), 2 + i_); } while (0)
+#define CONST_DOUBLE_FROM_EXTRACT(r, u)					\
+do { int i_;								\
+     for (i_ = 0; i_ < sizeof ((u).i) / sizeof ((u).i[0]); i_++)	\
+       XWINT ((r), 2 + i_) = (u).i[i_]; } while (0)
+
 /* Return a CONST_DOUBLE with value R and mode M.  */
 
 #define CONST_DOUBLE_FROM_REAL_VALUE(r, m) immed_real_const_1 (r,  m)
--- a/gcc/varasm.c
+++ b/gcc/varasm.c
@@ -2121,7 +2121,7 @@
